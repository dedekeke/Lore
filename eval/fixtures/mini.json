  {
    "id": "mini-002-attempt-ledger",
    "dataset": "synthetic",
    "events": [
      {
        "kind": "start_task",
        "task_ref": "t1",
        "description": "Fix flaky integration test in auth module"
      },
      {
        "kind": "propose_attempt",
        "task_ref": "t1",
        "approach": "Increase timeout from 1s to 5s"
      },
      {
        "kind": "log_outcome",
        "attempt_ref": "t1-a1",
        "outcome": "rejected",
        "reasoning": "Root cause was race condition in test setup, not timing"
      },
      {
        "kind": "recall_rules",
        "query": "auth module flaky test timeout",
        "expected_hits": ["attempt-t1-a1"]
      }
    ],
    "expected": {
      "recall_hit_ids": ["attempt-t1-a1"],
      "task_completion": false
    }
  },
