DATABASE_URL=postgres://lore:password@localhost:5432/ai_memory
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_SECS=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
# NOTE: Changing this value requires a new migration to alter vector column dimensions in the DB schema.
EMBEDDING_DIMENSIONS=384
MCP_TRANSPORT=stdio
MCP_SSE_PORT=3100
LOG_LEVEL=info
RETENTION_ATTEMPTS_DAYS=30
RETENTION_SNAPSHOTS_DAYS=7
RETENTION_TASKS_ARCHIVE_DAYS=90
RETENTION_UNKNOWN_DAYS=7
RETENTION_PENDING_ESCALATION_HOURS=72
DEFAULT_PROJECT_NAME=default
# Comma-separated list of tool names to disable (e.g., forget_rule,export_memory)
DISABLED_TOOLS=
# Webhook notifications (leave WEBHOOK_URL empty to disable)
WEBHOOK_URL=
WEBHOOK_EVENTS=task_completed,task_abandoned,rejection_threshold
WEBHOOK_REJECTION_THRESHOLD=3
